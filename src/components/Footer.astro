---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border text-muted-foreground flex flex-wrap items-center justify-between gap-4 border-t py-6 text-sm"
  >
    <span class="font-mono text-xs">
      {t.footer.copyright} &#169; {currentYear}
      {config.site.author}
    </span>
    <div class="flex items-center gap-1">
      <Socials />
      <a
        href={getRelativeLocaleUrl(locale, "rss.xml")}
        class="hover:text-accent p-1"
        title="RSS Feed"
      >
        <IconRss class="size-5" />
        <span class="sr-only">RSS Feed</span>
      </a>
    </div>
  </div>
</footer>
