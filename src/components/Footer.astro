---
import type { HTMLAttributes } from "astro/types";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout lg:hidden", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <p
    class="border-border text-muted-foreground border-t py-6 font-mono text-[11px]"
  >
    {t.footer.copyright} &#169; {currentYear}
    {config.site.author}
  </p>
</footer>
