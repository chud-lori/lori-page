---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import Socials from "./Socials.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const navItems = [
  { path: "/", label: "Home" },
  { path: "/posts", label: t.nav.posts },
  { path: "/tags", label: t.nav.tags },
  ...(features.showArchives
    ? [{ path: "/archives", label: t.nav.archives }]
    : []),
  { path: "/about", label: t.nav.about },
  ...(features.search !== false
    ? [{ path: "/search", label: t.nav.search }]
    : []),
];

const currentYear = new Date().getFullYear();
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header id="site-header" class="border-border border-b lg:border-b-0">
  <div
    class="border-border flex flex-col gap-6 px-6 py-8 sm:px-8 lg:sticky lg:top-0 lg:h-svh lg:gap-10 lg:overflow-y-auto lg:border-e lg:py-12"
  >
    <div>
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="font-serif text-4xl leading-none font-medium tracking-tight italic"
      >
        {site.title}
      </a>
      <p
        class="text-muted-foreground mt-3 font-serif text-[15px] leading-snug italic"
      >
        Notes on systems, backend internals, and the parts of software that
        matter.
      </p>
    </div>

    <nav aria-label="Primary">
      <ul class="flex flex-wrap gap-x-5 gap-y-1 lg:flex-col">
        {
          navItems.map(({ path, label }, i) => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, path.slice(1))}
                class:list={[
                  "hover:text-accent flex items-baseline gap-3 py-1 text-sm transition-colors",
                  { "active-nav": isActive(path) },
                ]}
                aria-current={isActive(path) ? "page" : undefined}
              >
                <span class="text-muted-foreground font-mono text-[10px] tracking-wider tabular-nums max-lg:hidden">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span>{label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex flex-col gap-4 lg:mt-auto">
      <div class="flex items-center gap-1">
        <Socials />
        <a
          href={getRelativeLocaleUrl(locale, "rss.xml")}
          class="text-muted-foreground hover:text-accent p-1"
          title="RSS Feed"
        >
          <IconRss class="size-5" />
          <span class="sr-only">RSS Feed</span>
        </a>
        {
          features.lightAndDarkMode && (
            <button
              id="theme-btn"
              class="focus-outline text-muted-foreground hover:text-accent relative ms-1 size-8"
              title={t.a11y.toggleTheme}
              aria-label="auto"
              aria-live="polite"
            >
              <IconMoon class="absolute top-1/2 left-1/2 size-5 -translate-1/2 scale-100 transition-all dark:scale-0" />
              <IconSunHigh class="absolute top-1/2 left-1/2 size-5 -translate-1/2 scale-0 transition-all dark:scale-100" />
            </button>
          )
        }
      </div>
      <p
        class="text-muted-foreground font-mono text-[11px] leading-relaxed max-lg:hidden"
      >
        &copy; {currentYear}
        {site.author}<br />
        Set in EB Garamond &amp; Inter.
      </p>
    </div>
  </div>
</header>
