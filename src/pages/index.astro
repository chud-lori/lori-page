---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const homePath = getRelativeLocaleUrl(locale, "");

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-CA", { timeZone: config.site.timezone });
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout py-12 sm:py-16"
  >
    <p class="max-w-2xl text-lg leading-relaxed">
      Hi, I'm Lori, a backend engineer. I write here about systems, low-level
      programming, security and the tools I build.
      <a
        href={getRelativeLocaleUrl(locale, "about")}
        class="text-accent decoration-accent/40 hover:decoration-accent underline underline-offset-4"
        >More about me</a
      >
    </p>

    <h2 class="text-muted-foreground mt-14 mb-4 font-mono text-sm">Posts</h2>
    <ol class="flex flex-col">
      {
        sortedPosts.map(({ id, filePath, data }) => (
          <li class="border-border flex flex-col gap-1 border-t py-3 sm:flex-row sm:items-baseline sm:gap-6">
            <time
              datetime={data.pubDatetime.toISOString()}
              class="text-muted-foreground shrink-0 font-mono text-sm tabular-nums sm:w-24"
            >
              {formatDate(data.pubDatetime)}
            </time>
            <a
              href={getPostUrl(id, filePath, locale)}
              class="text-accent decoration-accent/40 leading-snug font-medium underline-offset-4 hover:underline"
            >
              {data.title}
            </a>
          </li>
        ))
      }
    </ol>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
